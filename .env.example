# ==============================================================================
# MediLink (Lost in Transit) — Environment Variables
# ==============================================================================

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Remote project or local Supabase (default local URL: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── App Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true to explore the app with seeded demo data (Ananya Rao) without DB credentials
NEXT_PUBLIC_DEMO_MODE=true

# ─── AI Extraction Provider ───────────────────────────────────────────────────
# Options: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-openai-api-key
