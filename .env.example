# ==============================================================================
# MyHealthVault — Environment Variables
# ==============================================================================
# Copy to .env.local. Never commit real values. Configuration is validated at
# startup (lib/config/schema.ts); errors name the variable, never its value.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# true  = demo mode: fictional patient (Ananya Rao), no Supabase, no AI calls.
# false = real-user mode: requires the Supabase settings below.
# Server-only. (The old NEXT_PUBLIC_DEMO_MODE is rejected with a rename message.)
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs session and share-session cookies. Required in real-user mode and in
# any production deployment (including a deployed demo). 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Supabase (real-user mode only) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI extraction provider (used from Phase 3) ───────────────────────────────
# gemini | openai | none. AI counts as configured only with a key AND a model.
AI_PROVIDER=none
GEMINI_API_KEY=
# Set a currently supported, vision-capable model; there is deliberately no default.
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ─── OCR (used from Phase 3) ──────────────────────────────────────────────────
OCR_ENABLED=false
# paddleocr | none
OCR_PROVIDER=none
OCR_SERVICE_URL=
# Shared secret with the PaddleOCR service (32+ random characters).
OCR_SERVICE_TOKEN=

# ─── Backup AI (Groq), used only when Gemini/OCR is unavailable ────────────────
# Leave empty to disable the backup. Photos only (no PDFs). Models are optional
# overrides; defaults: openai/gpt-oss-120b (extraction), qwen/qwen3.8-27b (photos).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=

# ─── Upload limits ────────────────────────────────────────────────────────────
# Maximum 5.
MAX_UPLOAD_SIZE_MB=5
